# Required: your Gemini API key (Vercel → Project → Settings → Environment Variables)
GEMINI_API_KEY=your-gemini-key
# Optional: Gemini model (default gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: only allow calls from your site
ALLOWED_ORIGIN=https://your-project.vercel.app
